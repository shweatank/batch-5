#include <stdio.h>
#include <unistd.h>
#include <string.h>
#include <sys/types.h>
#include <fcntl.h>

void mycp(const char* dest,const char* src) {
	int srcfd = open(src,O_RDONLY);
	int destfd = open(dest,O_RDWR|O_TRUNC|O_CREAT,0777);
	if(srcfd == -1) {
		printf("Unable to open file..!");
		return;
	}
	char ch;
	while(read(srcfd,&ch,1) == 1) {
		write(destfd,&ch,1);
	}
}

int main(int argc,char **argv) {
	if(argc != 3) {
		printf("Invalid Arguments..!");
		return 0;
	}
	mycp(argv[1],argv[2]);
}


